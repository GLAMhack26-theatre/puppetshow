{
  "name": "puppetshow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sounds": "sh scripts/unpack-sounds.sh || echo \"sound effects not unpacked (needs sh and unzip): only ZzFX will play\"",
    "predev": "npm run sounds --silent",
    "dev": "vite",
    "predev:https": "npm run sounds --silent",
    "dev:https": "vite --mode https --host",
    "prebuild": "npm run sounds --silent",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@iwsdk/core": "^1.1.0-rc.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@trystero-p2p/ws-relay": "0.27.0",
    "trystero": "0.27.0",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  }
}
